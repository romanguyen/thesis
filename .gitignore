# Local configuration files - these are specific to your installation
# (conf/local.php and conf/plugins.local.php are tracked intentionally)
/conf/users.auth.php
/conf/acl.auth.php
/conf/license.php
/conf/mediameta.php
/conf/scheme.conf

# DokuWiki's generated data - we are NOT ignoring /pages/ or /media/
/data/attic/
/data/cache/
/data/index/
/data/meta/
/data/locks/
/data/log/
/data/tmp/
/data/media_attic/
/data/media_meta/
/data/deleted.files

# Composer dependencies
/vendor/

# Installed plugins (assuming you manage these via the admin interface)
/lib/plugins/

# Log files
*.log
error.log
debug.log

# Local backup artifacts
/conf/*.bak.php

# macOS metadata
.DS_Store
**/.DS_Store
